{
  "name": "vanta",
  "version": "0.1.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "mobile:test": "pnpm --dir apps/mobile test",
    "api:test": "cd backend && go test ./...",
    "api:run": "cd backend && go run ./cmd/api",
    "release:sync": "node scripts/sync-release-version.mjs --write",
    "release:check": "node scripts/sync-release-version.mjs --check && node scripts/validate-mobile-release-config.mjs",
    "release:metadata": "node scripts/write-build-metadata.mjs",
    "check": "pnpm release:check && pnpm mobile:typecheck && pnpm mobile:test && pnpm api:test"
  }
}
