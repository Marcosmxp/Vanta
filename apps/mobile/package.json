{
  "name": "@vanta/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app:validate": "expo export --platform android --output-dir .app-build",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo run:android",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo run:ios",
    "storybook:validate": "cross-env STORYBOOK_ENABLED=true expo export --platform android --output-dir .storybook-build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "5.102.2",
    "expo": "~57.0.0",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~3.0.0",
    "react": "19.2.3",
    "react-hook-form": "^7.0.0",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "^0.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/slider": "^5.0.1",
    "@storybook/addon-ondevice-actions": "10.5.4",
    "@storybook/addon-ondevice-backgrounds": "10.5.4",
    "@storybook/addon-ondevice-controls": "10.5.4",
    "@storybook/react-native": "10.5.4",
    "@types/react": "^19.2.0",
    "cross-env": "^10.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
