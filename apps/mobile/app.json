{
  "expo": {
    "name": "Vanta",
    "slug": "vanta-mobile",
    "scheme": "vanta",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permitir que o Vanta utilize o Face ID para proteger o acesso à conta."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marcosmxp.vanta",
      "buildNumber": "2",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.marcosmxp.vanta",
      "versionCode": 2
    },
    "githubUrl": "https://github.com/Marcosmxp/Vanta"
  }
}
