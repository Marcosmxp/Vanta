# Development-only placeholders. Never commit real staging/production credentials or keys.
VANTA_ENV=development
VANTA_API_PORT=8080
VANTA_LOG_LEVEL=debug

# PostgreSQL is the canonical persistent data store.
VANTA_DATABASE_URL=postgres://vanta:vanta_local_only@localhost:5432/vanta?sslmode=disable
VANTA_DATABASE_MAX_CONNS=10

# Redis is ephemeral only: throttling/cache/locks. Never financial truth.
VANTA_REDIS_URL=redis://localhost:6379/0

# Session policy.
VANTA_AUTH_ACCESS_TTL=15m
VANTA_AUTH_REFRESH_TTL=720h

# Development-only 32-byte base64 placeholders.
# Generate independent high-entropy keys for staging/production and inject them from a secret manager.
VANTA_PII_ENCRYPTION_KEY_B64=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
VANTA_PII_LOOKUP_KEY_B64=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Maintenance is selected by trusted backend/bootstrap state, never by the mobile client.
VANTA_MAINTENANCE_ENABLED=false
VANTA_MAINTENANCE_INCIDENT_ID=
VANTA_MAINTENANCE_MESSAGE=
VANTA_MAINTENANCE_RETRY_AFTER=

# Mobile public configuration. EXPO_PUBLIC_* values are embedded in the application binary.
# Never place secrets, database credentials, private keys, provider secrets or privileged tokens here.
EXPO_PUBLIC_VANTA_ENV=development
EXPO_PUBLIC_VANTA_API_URL=http://localhost:8080
