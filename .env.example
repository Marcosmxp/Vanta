# Development-only placeholders. Never commit real credentials.
VANTA_ENV=development
VANTA_API_PORT=8080
VANTA_DATABASE_URL=postgres://vanta:vanta_local_only@localhost:5432/vanta?sslmode=disable
VANTA_REDIS_URL=redis://localhost:6379/0
VANTA_LOG_LEVEL=debug

# Mobile public configuration. Values prefixed EXPO_PUBLIC_ are embedded in the client.
# Never place secrets, private keys, database credentials, or privileged tokens here.
EXPO_PUBLIC_VANTA_API_URL=http://localhost:8080
